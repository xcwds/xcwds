{
	"name": "@xcwds/plugin-lock",
	"version": "0.5.0",
	"description": "Privacy for private pages in @xcwds apps: a passcode lock with an unlock screen, a cover in the app switcher, and no spellcheck or autocomplete in their fields.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-lock"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./UnlockScreen.svelte": {
			"types": "./dist/UnlockScreen.svelte.d.ts",
			"svelte": "./dist/UnlockScreen.svelte",
			"default": "./dist/UnlockScreen.svelte"
		},
		"./LockSettings.svelte": {
			"types": "./dist/LockSettings.svelte.d.ts",
			"svelte": "./dist/LockSettings.svelte",
			"default": "./dist/LockSettings.svelte"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"peerDependencies": {
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"privacy",
		"private-pages",
		"passcode"
	],
	"engines": {
		"node": ">=22.18"
	}
}
