{
	"name": "@xcwds/plugin-blocks",
	"version": "0.3.0",
	"description": "Small apps people add to an @xcwds app (checklists, counters, logs, notes), defined as data rather than code.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-blocks"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./model": {
			"types": "./dist/model.d.ts",
			"default": "./dist/model.js"
		},
		"./YourApps.svelte": {
			"types": "./dist/YourApps.svelte.d.ts",
			"svelte": "./dist/YourApps.svelte",
			"default": "./dist/YourApps.svelte"
		},
		"./BlocksApp.svelte": {
			"types": "./dist/BlocksApp.svelte.d.ts",
			"svelte": "./dist/BlocksApp.svelte",
			"default": "./dist/BlocksApp.svelte"
		},
		"./AppBuilder.svelte": {
			"types": "./dist/AppBuilder.svelte.d.ts",
			"svelte": "./dist/AppBuilder.svelte",
			"default": "./dist/AppBuilder.svelte"
		},
		"./ImportApp.svelte": {
			"types": "./dist/ImportApp.svelte.d.ts",
			"svelte": "./dist/ImportApp.svelte",
			"default": "./dist/ImportApp.svelte"
		},
		"./ShareDesign.svelte": {
			"types": "./dist/ShareDesign.svelte.d.ts",
			"svelte": "./dist/ShareDesign.svelte",
			"default": "./dist/ShareDesign.svelte"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-tools": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"tracker",
		"checklist"
	],
	"engines": {
		"node": ">=22.18"
	},
	"types": "./dist/index.d.ts",
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	}
}
