{
	"name": "@xcwds/plugin-camera",
	"version": "0.0.0",
	"private": true,
	"description": "Photos taken inside an @xcwds app, with no metadata and the camera on only while it's used. Work in progress (#145), not published yet.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-camera"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./camera": {
			"types": "./dist/camera.d.ts",
			"default": "./dist/camera.js"
		},
		"./help": {
			"types": "./dist/help.d.ts",
			"default": "./dist/help.js"
		},
		"./image": {
			"types": "./dist/image.d.ts",
			"default": "./dist/image.js"
		},
		"./photos": {
			"types": "./dist/photos.d.ts",
			"default": "./dist/photos.js"
		},
		"./share": {
			"types": "./dist/share.d.ts",
			"default": "./dist/share.js"
		},
		"./Camera.svelte": {
			"types": "./dist/Camera.svelte.d.ts",
			"svelte": "./dist/Camera.svelte",
			"default": "./dist/Camera.svelte"
		},
		"./Photos.svelte": {
			"types": "./dist/Photos.svelte.d.ts",
			"svelte": "./dist/Photos.svelte",
			"default": "./dist/Photos.svelte"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"peerDependencies": {
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"camera",
		"exif",
		"privacy"
	],
	"engines": {
		"node": ">=22.18"
	}
}
