{
	"name": "@xcwds/core",
	"version": "0.2.0",
	"description": "The @xcwds kernel: plugins, hooks, decorators, config, storage and settings for private, offline-first PWAs.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/core"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./build": {
			"types": "./dist/build/index.d.ts",
			"default": "./dist/build/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"publint": "publint"
	},
	"devDependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"typescript": "^5.9.3",
		"vitest": "^4.0.15"
	},
	"peerDependencies": {
		"@resvg/resvg-js": "^2.6.0"
	},
	"peerDependenciesMeta": {
		"@resvg/resvg-js": {
			"optional": true
		}
	},
	"keywords": [
		"pwa",
		"offline-first",
		"plugins",
		"xcwds"
	],
	"engines": {
		"node": ">=22.18"
	}
}
