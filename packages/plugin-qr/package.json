{
	"name": "@xcwds/plugin-qr",
	"version": "0.0.0",
	"description": "QR codes made and scanned on the device in an @xcwds app, with nothing sent anywhere.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css",
		"**/*.worker.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-qr"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./make": {
			"types": "./dist/make.d.ts",
			"default": "./dist/make.js"
		},
		"./QrCode.svelte": {
			"types": "./dist/QrCode.svelte.d.ts",
			"svelte": "./dist/QrCode.svelte",
			"default": "./dist/QrCode.svelte"
		},
		"./scan": {
			"types": "./dist/scan.d.ts",
			"default": "./dist/scan.js"
		},
		"./QrScanner.svelte": {
			"types": "./dist/QrScanner.svelte.d.ts",
			"svelte": "./dist/QrScanner.svelte",
			"default": "./dist/QrScanner.svelte"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"dependencies": {
		"jsqr": "^1.4.0"
	},
	"peerDependencies": {
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-camera": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-camera": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"qr",
		"qr-code",
		"privacy"
	],
	"engines": {
		"node": ">=22.18"
	}
}
