{
	"name": "@xcwds/plugin-vault",
	"version": "0.0.0",
	"private": true,
	"description": "Encryption at rest for the sensitive storage groups of @xcwds apps that use @xcwds/plugin-lock. Work in progress (#79), not published yet.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-vault"
	},
	"exports": {
		"./blobs": {
			"types": "./dist/blobs.d.ts",
			"default": "./dist/blobs.js"
		},
		"./seal": {
			"types": "./dist/seal.d.ts",
			"default": "./dist/seal.js"
		},
		"./vault": {
			"types": "./dist/vault.d.ts",
			"default": "./dist/vault.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"publint": "publint"
	},
	"peerDependencies": {
		"@xcwds/core": "workspace:^"
	},
	"devDependencies": {
		"@xcwds/core": "workspace:^",
		"typescript": "~6.0.3",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"privacy",
		"encryption"
	],
	"engines": {
		"node": ">=22.18"
	}
}
