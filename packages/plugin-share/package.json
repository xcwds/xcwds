{
	"name": "@xcwds/plugin-share",
	"version": "0.1.0",
	"description": "Sharing for @xcwds apps: a Share button in the installed app that never shares what you typed, and a private share target whose shared content never reaches a server.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-share"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./worker": {
			"types": "./dist/worker.d.ts",
			"default": "./dist/worker.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.20.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-shell": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-shell": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vitest": "^4.0.15"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"share",
		"share-target"
	],
	"engines": {
		"node": ">=22.18"
	},
	"peerDependenciesMeta": {
		"@xcwds/plugin-shell": {
			"optional": true
		}
	}
}
