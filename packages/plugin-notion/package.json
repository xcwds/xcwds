{
	"name": "@xcwds/plugin-notion",
	"version": "0.0.0",
	"private": true,
	"description": "Notion pages saved on the device in @xcwds apps, read through a stateless relay. Work in progress (#102), not published yet.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-notion"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./api": {
			"types": "./dist/api.d.ts",
			"default": "./dist/api.js"
		},
		"./document": {
			"types": "./dist/document.d.ts",
			"default": "./dist/document.js"
		},
		"./sources": {
			"types": "./dist/sources.d.ts",
			"default": "./dist/sources.js"
		},
		"./render": {
			"types": "./dist/render.d.ts",
			"default": "./dist/render.js"
		},
		"./NotionDocument.svelte": {
			"types": "./dist/NotionDocument.svelte.d.ts",
			"svelte": "./dist/NotionDocument.svelte",
			"default": "./dist/NotionDocument.svelte"
		},
		"./NotionView.svelte": {
			"types": "./dist/NotionView.svelte.d.ts",
			"svelte": "./dist/NotionView.svelte",
			"default": "./dist/NotionView.svelte"
		},
		"./NotionSources.svelte": {
			"types": "./dist/NotionSources.svelte.d.ts",
			"svelte": "./dist/NotionSources.svelte",
			"default": "./dist/NotionSources.svelte"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"relay",
		"!relay/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"privacy",
		"notion"
	],
	"engines": {
		"node": ">=22.18"
	}
}
