{
	"name": "@xcwds/plugin-settings",
	"version": "0.9.0",
	"description": "The settings page for @xcwds apps: every plugin's settings with built-in controls, sections plugins add, backups (download, share, import, clear) and About.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-settings"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./SettingsPage.svelte": {
			"types": "./dist/SettingsPage.svelte.d.ts",
			"svelte": "./dist/SettingsPage.svelte",
			"default": "./dist/SettingsPage.svelte"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-shell": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-shell": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"settings",
		"backup"
	],
	"engines": {
		"node": ">=22.18"
	},
	"peerDependenciesMeta": {
		"@xcwds/plugin-shell": {
			"optional": true
		}
	}
}
