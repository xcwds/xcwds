{
	"name": "@xcwds/plugin-scanner",
	"version": "0.0.0",
	"description": "Scan paper documents to a PDF on the device in @xcwds apps, without a cloud scanning app.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css",
		"**/*.worker.js"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-scanner"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./Crop.svelte": {
			"types": "./dist/Crop.svelte.d.ts",
			"svelte": "./dist/Crop.svelte",
			"default": "./dist/Crop.svelte"
		},
		"./Pages.svelte": {
			"types": "./dist/Pages.svelte.d.ts",
			"svelte": "./dist/Pages.svelte",
			"default": "./dist/Pages.svelte"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./corners": {
			"types": "./dist/corners.d.ts",
			"default": "./dist/corners.js"
		},
		"./crop": {
			"types": "./dist/crop.d.ts",
			"default": "./dist/crop.js"
		},
		"./encode": {
			"types": "./dist/encode.d.ts",
			"default": "./dist/encode.js"
		},
		"./filters": {
			"types": "./dist/filters.d.ts",
			"default": "./dist/filters.js"
		},
		"./geometry": {
			"types": "./dist/geometry.d.ts",
			"default": "./dist/geometry.js"
		},
		"./pages": {
			"types": "./dist/pages.d.ts",
			"default": "./dist/pages.js"
		},
		"./pdf": {
			"types": "./dist/pdf.d.ts",
			"default": "./dist/pdf.js"
		},
		"./process": {
			"types": "./dist/process.d.ts",
			"default": "./dist/process.js"
		},
		"./share": {
			"types": "./dist/share.d.ts",
			"default": "./dist/share.js"
		},
		"./warp": {
			"types": "./dist/warp.d.ts",
			"default": "./dist/warp.js"
		},
		"./warp-gl": {
			"types": "./dist/warp-gl.d.ts",
			"default": "./dist/warp-gl.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"peerDependencies": {
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"privacy",
		"scanner",
		"pdf"
	],
	"engines": {
		"node": ">=22.18"
	}
}
