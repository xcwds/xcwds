{
	"name": "@xcwds/plugin-tools",
	"version": "0.8.0",
	"description": "A tool registry for @xcwds apps: an index page of small tools, pinned and recently used tools on Home, and manifest shortcuts, with private tools kept out of recents and sharing.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte",
		"**/*.css"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/plugin-tools"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./ToolList.svelte": {
			"types": "./dist/ToolList.svelte.d.ts",
			"svelte": "./dist/ToolList.svelte",
			"default": "./dist/ToolList.svelte"
		},
		"./HomeShortcuts.svelte": {
			"types": "./dist/HomeShortcuts.svelte.d.ts",
			"svelte": "./dist/HomeShortcuts.svelte",
			"default": "./dist/HomeShortcuts.svelte"
		},
		"./AppCatalog.svelte": {
			"types": "./dist/AppCatalog.svelte.d.ts",
			"svelte": "./dist/AppCatalog.svelte",
			"default": "./dist/AppCatalog.svelte"
		},
		"./AppOffNotice.svelte": {
			"types": "./dist/AppOffNotice.svelte.d.ts",
			"svelte": "./dist/AppOffNotice.svelte",
			"default": "./dist/AppOffNotice.svelte"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-shell": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@xcwds/core": "workspace:^",
		"@xcwds/plugin-shell": "workspace:^",
		"@xcwds/sveltekit": "workspace:^",
		"@xcwds/testing": "workspace:*",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"xcwds",
		"xcwds-plugin",
		"tools",
		"shortcuts"
	],
	"engines": {
		"node": ">=22.18"
	},
	"peerDependenciesMeta": {
		"@xcwds/plugin-shell": {
			"optional": true
		}
	}
}
