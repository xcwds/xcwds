{
	"name": "@xcwds/sveltekit",
	"version": "0.8.0",
	"description": "Binds the @xcwds kernel to SvelteKit: a Vite plugin that sets up SvelteKit, server hooks, the <App> component, Svelte 5 persist() and reactive settings, and a route registry.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.svelte"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xcwds/xcwds.git",
		"directory": "packages/sveltekit"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./vite": {
			"types": "./dist/vite.d.ts",
			"default": "./dist/vite.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"default": "./dist/hooks.js"
		},
		"./worker": {
			"types": "./dist/worker.d.ts",
			"default": "./dist/worker.js"
		},
		"./guard": {
			"types": "./dist/guard.d.ts",
			"default": "./dist/guard.js"
		},
		"./routes": {
			"types": "./dist/routes.d.ts",
			"default": "./dist/routes.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"publint": "publint"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^4.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@xcwds/core": "workspace:^",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"@xcwds/core": "workspace:^",
		"svelte": "^5.0.0",
		"vite": "^8.0.12"
	},
	"keywords": [
		"pwa",
		"offline-first",
		"sveltekit",
		"vite-plugin",
		"xcwds"
	],
	"engines": {
		"node": ">=22.18"
	}
}
