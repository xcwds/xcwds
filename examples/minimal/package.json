		"@xcwds/sveltekit": "workspace:*"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.3",
		"@xcwds/testing": "workspace:*",
		"jsqr": "^1.4.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.4"
	}
