		"@xcwds/plugin-camera": "workspace:*",
		"@xcwds/plugin-changelog": "workspace:*",
		"@xcwds/plugin-install": "workspace:*",
		"@xcwds/plugin-lock": "workspace:*",
		"@xcwds/plugin-notion": "workspace:*",
		"@xcwds/plugin-offline": "workspace:*",
		"@xcwds/plugin-qr": "workspace:*",
		"@xcwds/plugin-recorder": "workspace:*",
		"@xcwds/plugin-scanner": "workspace:*",
		"@xcwds/plugin-settings": "workspace:*",
		"@xcwds/plugin-share": "workspace:*",
		"@xcwds/plugin-shell": "workspace:*",
		"@xcwds/plugin-theme": "workspace:*",
		"@xcwds/plugin-timers": "workspace:*",
		"@xcwds/plugin-tools": "workspace:*",
		"@xcwds/plugin-update": "workspace:*",
