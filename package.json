{
	"name": "xcwds-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "pnpm --filter \"./packages/*\" --filter ./examples/plugin-tally build",
		"check": "pnpm -r check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:e2e": "pnpm --filter \"./examples/*\" --filter \"!./examples/starter\" --filter ./site test:e2e",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"publint": "pnpm --filter \"./packages/*\" --filter ./examples/plugin-tally publint",
		"changeset": "changeset",
		"test:starter": "node packages/create/scripts/test-starter.js",
		"version-packages": "node packages/create/scripts/release-create.js && node scripts/peer-dependent-changesets.js && changeset version && node scripts/check-release-plan.js && node scripts/sync-core-version.js && pnpm install --lockfile-only",
		"release": "pnpm build && node scripts/copy-license.js && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.0.0",
		"@eslint/js": "^10.0.0",
		"@types/node": "^26.0.0",
		"eslint": "^10.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^17.0.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^4.0.0",
		"publint": "^0.3.15",
		"semver": "^7.8.5",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.48.1",
		"vitest": "^5.0.0"
	}
}
